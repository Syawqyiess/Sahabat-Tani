<%- include('../partials/head') %>
<div class="page-head"><h1>Manajemen Pengguna</h1><a class="btn" href="/admin/pengguna/baru"><%- icon('plus', 18) %> Tambah petani</a></div>
<form method="get" class="search" role="search">
  <label for="q" class="visually-hidden">Cari pengguna</label>
  <input id="q" name="q" type="search" value="<%= q %>" placeholder="Cari nama, HP, atau email">
  <button class="btn" type="submit">Cari</button>
</form>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Nama</th><th>Kontak</th><th>Peran</th><th>Lahan / Scan</th><th>Status</th><th>Aksi</th></tr></thead>
  <tbody>
  <% users.forEach((x) => { %>
    <tr>
      <td><%= x.full_name || 'Belum diisi' %><% if (x.is_demo) { %> <span class="badge badge-demo">Demo</span><% } %><br><span class="small muted"><%= x.regency || '' %></span></td>
      <td class="small"><%= x.phone || '—' %><br><%= x.email || '' %></td>
      <td><%= x.role === 'admin' ? 'Admin' : 'Petani' %></td>
      <td><%= x.land_count %> / <%= x.scan_count %></td>
      <td><%= x.is_active ? 'Aktif' : 'Nonaktif' %></td>
      <td class="actions">
        <% if (x.role === 'farmer') { %><a class="btn btn-sm btn-ghost" href="/admin/pengguna/<%= x.id %>">Data</a><% } %>
        <% if (x.id !== currentUser.id) { %>
          <form method="post" action="/admin/pengguna/<%= x.id %>/status" data-confirm="<%= x.is_active ? 'Nonaktifkan akun ini? Pengguna akan langsung keluar.' : 'Aktifkan kembali akun ini?' %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm <%= x.is_active ? 'btn-danger btn-ghost' : '' %>" type="submit"><%= x.is_active ? 'Nonaktifkan' : 'Aktifkan' %></button>
          </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('../partials/foot') %>
