<%- include('../partials/head') %>
<% const withIntro = typeof intro !== 'undefined' && intro; %>
<% if (withIntro) { %>
  <div class="intro" aria-hidden="true">
    <div class="intro-mark">
      <img src="/static/img/logo.png" alt="" width="104" height="104" fetchpriority="high">
      <span class="intro-name">Sahabat Tani</span>
      <span class="intro-tag">Teman petani padi</span>
    </div>
  </div>
<% } %>
<div class="auth-wrap auth-enter<%= withIntro ? ' with-intro' : '' %>">
  <%- include('../partials/auth-art') %>
  <div class="auth">
    <h1>Masuk</h1>
    <p class="muted">Gunakan nomor HP atau email yang terdaftar.</p>
    <% if (inactive) { %><div class="alert alert-error" role="alert"><%- icon('alert') %><span>Akun Anda dinonaktifkan. Hubungi admin.</span></div><% } %>
    <% if (resetDone) { %><div class="alert alert-success" role="status"><%- icon('check') %><span>Kata sandi berhasil diganti. Silakan masuk.</span></div><% } %>
    <% if (errors.form) { %><div class="alert alert-error" role="alert"><%- icon('alert') %><span><%= errors.form %></span></div><% } %>
    <form method="post" action="/masuk" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/field', { name: 'identifier', label: 'Nomor HP atau email', value: values.identifier, autocomplete: 'username', required: true, placeholder: '0812xxxxxxx' }) %>
      <%- include('../partials/field', { name: 'password', label: 'Kata sandi', type: 'password', value: '', autocomplete: 'current-password', required: true, reveal: true }) %>
      <button class="btn btn-lg btn-block" type="submit" data-busy="Memeriksa…">Masuk</button>
    </form>
    <%- include('../partials/google-button', { source: 'masuk' }) %>
    <div class="auth-links"><a href="/lupa-sandi">Lupa kata sandi?</a><span>Belum punya akun? <a href="/daftar">Daftar</a></span></div>
    <% if (showDemoAccounts) { %>
    <details class="demo-box" open>
      <summary><%- icon('user', 18) %> Akun demo untuk mencoba</summary>
      <p class="small muted" style="margin:var(--s-2) 0 var(--s-3)">Klik tombol akun untuk mengisi otomatis dan masuk:</p>
      <div class="demo-btns">
        <button type="button" class="btn-demo" data-demo-id="081200000001" data-demo-pw="tani12345" title="Masuk sebagai Petani 1">
          <div class="demo-btn-body">
            <span class="demo-btn-title"><%- icon('user', 16) %> <strong>Petani 1</strong></span>
            <span class="demo-btn-meta"><code>081200000001</code> / <code>tani12345</code> (Profil Lengkap)</span>
          </div>
          <span class="demo-btn-action">Masuk <%- icon('arrowRight', 16) %></span>
        </button>
        <button type="button" class="btn-demo" data-demo-id="081200000002" data-demo-pw="tani12345" title="Masuk sebagai Petani 2">
          <div class="demo-btn-body">
            <span class="demo-btn-title"><%- icon('user', 16) %> <strong>Petani 2</strong></span>
            <span class="demo-btn-meta"><code>081200000002</code> / <code>tani12345</code> (Profil Baru)</span>
          </div>
          <span class="demo-btn-action">Masuk <%- icon('arrowRight', 16) %></span>
        </button>
        <button type="button" class="btn-demo btn-demo-admin" data-demo-id="admin@sahabattani.test" data-demo-pw="admin12345" title="Masuk sebagai Admin">
          <div class="demo-btn-body">
            <span class="demo-btn-title"><%- icon('shield', 16) %> <strong>Admin</strong></span>
            <span class="demo-btn-meta"><code>admin@sahabattani.test</code> / <code>admin12345</code></span>
          </div>
          <span class="demo-btn-action">Masuk <%- icon('arrowRight', 16) %></span>
        </button>
      </div>
      <p class="small" style="margin:var(--s-3) 0 0">Hanya untuk demo. Hapus akun demo sebelum digunakan dengan data asli.</p>
    </details>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
