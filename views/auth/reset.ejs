<%- include('../partials/head') %>
<div class="auth-wrap">
<%- include('../partials/auth-art') %>
<div class="auth">
  <h1>Atur Ulang Kata Sandi</h1>
  <% if (invalid) { %>
    <div class="alert alert-error" role="alert"><%- icon('alert') %><span>Tautan tidak berlaku atau sudah kedaluwarsa.</span></div>
    <p><a class="btn" href="/lupa-sandi">Minta tautan baru</a></p>
  <% } else { %>
    <form method="post" action="/reset-sandi/<%= token %>" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/field', { name: 'password', label: 'Kata sandi baru', type: 'password', value: '', error: errors.password, autocomplete: 'new-password', required: true, reveal: true, hint: 'Minimal 8 karakter.' }) %>
      <%- include('../partials/field', { name: 'password_confirm', label: 'Ulangi kata sandi baru', type: 'password', value: '', error: errors.password_confirm, autocomplete: 'new-password', required: true, reveal: true }) %>
      <button class="btn btn-lg btn-block" type="submit">Simpan kata sandi</button>
    </form>
  <% } %>
</div>
</div>
<%- include('../partials/foot') %>
