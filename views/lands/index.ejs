<%- include('../partials/head') %>
<div class="page-head">
  <div><h1>Lahan Saya</h1><p class="muted">Foto, jenis tanaman, luas, dan koordinat boleh dilengkapi kapan saja.</p></div>
  <div class="row wrap-row">
    <% if (lands.length) { %><a class="btn btn-ghost" href="/lahan/peta"><%- icon('map', 20) %> Lihat di Peta</a><% } %>
    <a class="btn" href="/lahan/baru"><%- icon('plus', 20) %> Tambah Lahan</a>
  </div>
</div>
<% if (!lands.length) { %>
  <%- include('../partials/empty', { heading: 'Belum ada lahan', text: 'Tambahkan lahan pertama Anda. Luas dan koordinat boleh diisi nanti.', actions: [{ href: '/lahan/baru', label: 'Tambahkan Lahan', icon: 'plus' }] }) %>
<% } else { %>
  <% const sum = crop.areaSummary(lands); %>
  <div class="land-strip" role="group" aria-label="Ringkasan lahan">
    <div><span class="land-strip-num"><%= sum.count %></span><span class="small muted">petak lahan</span></div>
    <div><span class="land-strip-num"><%= sum.totalLabel || '—' %></span><span class="small muted">total luas<%= sum.missing && sum.withArea ? ' (' + sum.withArea + ' dari ' + sum.count + ' petak tercatat)' : '' %></span></div>
    <% if (sum.missing) { %><p class="small muted" style="margin:0"><%= sum.missing %> petak belum diisi luasnya, jadi tidak ikut dihitung.</p><% } %>
  </div>
  <ul class="land-grid">
    <% lands.forEach((l, i) => { %>
      <li class="land-card">
        <%- include('photo', { l, eager: i < 2 }) %>
        <div class="land-card-body">
          <div>
            <h2><a href="/lahan/<%= l.id %>"><%= l.name %></a></h2>
            <p class="land-loc"><%- icon('location', 16) %> <%= l.address_desc || 'Lokasi belum diisi' %></p>
          </div>
          <dl class="land-facts">
            <div><dt>Jenis Tanaman</dt><dd><%- l.commodity ? u.stripHtml(l.commodity) : '<span class="empty-val">Belum diisi</span>' %></dd></div>
            <div><dt>Luas</dt><dd><%- l.area_ha != null ? crop.fmtHa(l.area_ha) : '<span class="empty-val">Belum diisi</span>' %></dd></div>
            <% const age = crop.cropAge(l); const fa = crop.phaseAgeLabel(age); %>
            <div><dt>Fase &amp; Umur</dt><dd><%- fa ? u.stripHtml(fa) + (age.phaseEstimated ? ' <span class="est" title="Fase diperkirakan dari umur tanaman">perkiraan</span>' : '') : '<span class="empty-val">Tanggal tanam belum diisi</span>' %></dd></div>
          </dl>
          <div class="land-actions">
            <a class="btn" href="/lahan/<%= l.id %>">Lihat Detail</a>
            <% if (l.lat != null || l.polygon) { %><a class="btn btn-text" href="/lahan/peta?pilih=<%= l.id %>"><%- icon('map', 18) %> Di peta</a><% } else { %><a class="btn btn-text" href="/lahan/<%= l.id %>/ubah"><%- icon('location', 18) %> Isi koordinat</a><% } %>
            <a class="btn btn-text" href="/lahan/<%= l.id %>/ubah"><%- icon('edit', 18) %> Ubah</a>
          </div>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('../partials/foot') %>
