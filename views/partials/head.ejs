<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <meta name="theme-color" content="#1e5631">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> · Sahabat Tani</title>
  <link rel="icon" href="/static/img/favicon-48.png" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <script src="/static/js/early.js"></script>
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/js/app.js" defer></script>
</head>
<%
  const me = currentUser;
  const isFarmer = me && me.role === 'farmer';
  const isAdmin = me && me.role === 'admin';
  // Tata letak halaman: 'chat' = ruang kerja setinggi layar tanpa footer panjang; 'fill' = isi tumbuh mengisi sisa tinggi.
  const pageLayout = (typeof layout !== 'undefined' && layout) || '';
  // Pencocokan rute eksplisit per menu (bukan prefix luas): Peta Lahan tidak ikut mengaktifkan Lahan Saya.
  const R = {
    dashboard: () => path === '/dashboard',
    lahan: () => path === '/lahan' || path === '/lahan/baru' || /^\/lahan\/\d+(\/ubah)?$/.test(path),
    peta: () => path === '/lahan/peta',
    udara: () => path === '/udara',
    kalender: () => path === '/kalender-tanam',
    asisten: () => path === '/asisten' || /^\/asisten\//.test(path),
    artikel: () => path === '/artikel' || /^\/artikel\/[^/]+$/.test(path),
    tersimpan: () => path === '/artikel-tersimpan',
    scan: () => path === '/scan' || path === '/scan/riwayat',
    profil: () => path === '/profil' || path === '/profil/ubah',
    admin: (p) => path === p || (p !== '/admin' && path.startsWith(p + '/')),
  };
  const farmerMenu = [
    { href: '/dashboard', label: 'Dashboard', icon: 'home', on: R.dashboard() },
    { label: 'Lahan & Lingkungan', id: 'dd-lahan', icon: 'field', on: R.lahan() || R.peta() || R.udara() || R.kalender(), items: [
      { href: '/lahan', label: 'Lahan Saya', icon: 'field', on: R.lahan() },
      { href: '/lahan/peta', label: 'Peta Lahan', icon: 'map', on: R.peta() },
      { href: '/udara', label: 'Kualitas Udara', icon: 'air', on: R.udara() },
    ] },
    { href: '/asisten', label: 'Asisten AI', icon: 'chat', on: R.asisten() },
    { label: 'Edukasi', id: 'dd-edukasi', icon: 'article', on: R.artikel() || R.tersimpan(), items: [
      { href: '/artikel', label: 'Berita & Artikel', icon: 'article', on: R.artikel() },
      { href: '/artikel-tersimpan', label: 'Artikel Tersimpan', icon: 'bookmark', on: R.tersimpan() },
    ] },
  ];
  const adminMenu = [
    { href: '/admin', label: 'Dashboard', icon: 'home', on: path === '/admin' || path === '/admin/' },
    { href: '/admin/pengguna', label: 'Pengguna', icon: 'users', on: R.admin('/admin/pengguna') },
    { href: '/admin/lahan', label: 'Lahan', icon: 'field', on: R.admin('/admin/lahan') },
    { label: 'Konten', id: 'dd-konten', icon: 'article', on: ['/admin/artikel', '/admin/kategori', '/admin/sumber-berita', '/admin/referensi-hama'].some((p) => R.admin(p)), items: [
      { href: '/admin/artikel', label: 'Artikel', icon: 'article', on: R.admin('/admin/artikel') },
      { href: '/admin/kategori', label: 'Kategori', icon: 'tag', on: R.admin('/admin/kategori') },
      { href: '/admin/sumber-berita', label: 'Sumber Berita', icon: 'news', on: R.admin('/admin/sumber-berita') },
      { href: '/admin/referensi-hama', label: 'Referensi Hama', icon: 'bug', on: R.admin('/admin/referensi-hama') },
    ] },
    { href: '/admin/integrasi', label: 'Integrasi', icon: 'settings', on: R.admin('/admin/integrasi') },
  ];
  const publicMenu = [{ href: '/artikel', label: 'Artikel', icon: 'article', on: R.artikel() }];
  const menu = isAdmin ? adminMenu : (isFarmer ? farmerMenu : publicMenu);
  const name = me ? ((me.full_name || '').replace(/\s*\(Akun Demo\)\s*$/, '').trim() || me.phone || me.email || 'Akun saya') : '';
  const initial = me ? (name.trim()[0] || '?').toUpperCase() : '';
  const home = isAdmin ? '/admin' : (isFarmer ? '/dashboard' : '/');
  const cur = (on) => on ? 'aria-current="page"' : '';
%>
<body class="<%= me ? 'is-app' : 'is-public' %><%= pageLayout ? ' layout-' + pageLayout : '' %>">
<a class="skip" href="#isi">Lewati ke isi</a>
<div class="app">
  <div class="app-main">
    <header class="topnav" data-topnav>
      <nav class="pill-nav" aria-label="Navigasi utama">
        <a class="pill-brand" href="<%= home %>"><img src="/static/img/logo-128.png" alt="" width="36" height="36"><span>Sahabat Tani<% if (isAdmin) { %><small>Admin</small><% } %></span></a>

        <ul class="pill-menu" role="list">
          <% menu.forEach((m) => { %>
            <li class="pill-item">
              <% if (m.items) { %>
                <button type="button" class="pill-link<%= m.on ? ' is-active' : '' %>" data-dd="<%= m.id %>" aria-expanded="false" aria-controls="<%= m.id %>"><%= m.label %> <%- icon('down', 14) %></button>
                <ul class="dd-menu" id="<%= m.id %>" role="list" hidden>
                  <% m.items.forEach((it) => { %><li><a class="dd-link<%= it.on ? ' is-active' : '' %>" href="<%= it.href %>" <%- cur(it.on) %>><%- icon(it.icon, 18) %> <%= it.label %></a></li><% }) %>
                </ul>
              <% } else { %>
                <a class="pill-link<%= m.on ? ' is-active' : '' %>" href="<%= m.href %>" <%- cur(m.on) %> aria-label="<%= m.label %>"><% if (!me) { %><span class="pill-ic"><%- icon(m.icon, 20) %></span><% } %><span class="pill-label"><%= m.label %></span></a>
              <% } %>
            </li>
          <% }) %>
        </ul>

        <div class="pill-actions">
          <% if (isFarmer) { %>
            <a class="btn btn-scan pill-scan<%= R.scan() ? ' is-active' : '' %>" href="/scan" <%- cur(R.scan()) %>><%- icon('camera', 20) %><span class="label-long">Scan Hama Padi</span><span class="label-short">Scan Hama</span></a>
          <% } %>
          <% if (me) { %>
            <div class="pill-item pill-account">
              <button type="button" class="avatar-btn<%= R.profil() ? ' is-active' : '' %>" data-dd="dd-akun" aria-expanded="false" aria-controls="dd-akun" aria-label="Menu akun <%= name %>">
                <% if (me.photo_path) { %><img class="avatar-mini" src="/media/<%= me.photo_path %>" alt="" width="40" height="40"><% } else { %><span class="avatar-mini" aria-hidden="true"><%= initial %></span><% } %>
              </button>
              <div class="dd-menu dd-right" id="dd-akun" hidden>
                <div class="dd-head"><strong><%= name %></strong><span class="small muted"><%= me.phone || me.email %></span><% if (me.is_demo) { %><span class="badge badge-demo">Akun Demo</span><% } %></div>
                <ul role="list">
                  <% if (isFarmer) { %><li><a class="dd-link<%= R.profil() ? ' is-active' : '' %>" href="/profil" <%- cur(R.profil()) %>><%- icon('user', 18) %> Profil Saya</a></li><% } %>
                  <li><form method="post" action="/keluar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="dd-link"><%- icon('logout', 18) %> Keluar</button></form></li>
                </ul>
              </div>
            </div>
            <button type="button" class="icon-btn nav-burger" data-nav-toggle aria-expanded="false" aria-controls="nav-drawer" aria-label="Buka menu navigasi"><%- icon('menu') %></button>
          <% } else { %>
            <a class="pill-link pill-login<%= path === '/masuk' ? ' is-active' : '' %>" href="/masuk" <%- cur(path === '/masuk') %>>Masuk</a>
            <a class="btn btn-sm pill-cta" href="/daftar" <%- cur(path === '/daftar') %>>Daftar</a>
          <% } %>
        </div>
      </nav>

      <% if (me) { %>
        <div class="nav-drawer" id="nav-drawer" hidden>
          <% menu.forEach((m) => { %>
            <% if (m.items) { %>
              <p class="nav-drawer-label"><%= m.label %></p>
              <% m.items.forEach((it) => { %><a class="dd-link<%= it.on ? ' is-active' : '' %>" href="<%= it.href %>" <%- cur(it.on) %>><%- icon(it.icon, 20) %> <%= it.label %></a><% }) %>
            <% } else { %>
              <a class="dd-link<%= m.on ? ' is-active' : '' %>" href="<%= m.href %>" <%- cur(m.on) %>><%- icon(m.icon, 20) %> <%= m.label %></a>
            <% } %>
          <% }) %>
          <p class="nav-drawer-label">Akun · <%= name %><% if (me.is_demo) { %> <span class="badge badge-demo">Akun Demo</span><% } %></p>
          <% if (isFarmer) { %><a class="dd-link<%= R.profil() ? ' is-active' : '' %>" href="/profil"><%- icon('user', 20) %> Profil Saya</a><% } %>
          <form method="post" action="/keluar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="dd-link"><%- icon('logout', 20) %> Keluar</button></form>
        </div>
      <% } %>
    </header>

<% if (me) { %>
    <main id="isi" class="content<%= pageLayout ? ' content-' + pageLayout : '' %>">
<% } else { %>
    <main id="isi" class="container pub-main<%= pageLayout ? ' content-' + pageLayout : '' %>">
<% } %>
<div class="toast-region" aria-live="polite">
  <% if (flash) { %>
    <div class="toast <%= flash.type === 'error' ? 'toast-error' : '' %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>" data-toast="<%= flash.type %>">
      <%- icon(flash.type === 'error' ? 'alert' : 'check') %><span><%= flash.text %></span>
      <button type="button" class="icon-btn" data-toast-close aria-label="Tutup pemberitahuan"><%- icon('close', 18) %></button>
    </div>
  <% } %>
</div>
