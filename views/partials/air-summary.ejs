<% if (typeof error !== 'undefined' && error) { %>
  <div class="state state-inline state-error" role="status">
    <%- icon('alert') %>
    <div><p><strong>Informasi kualitas udara belum tersedia.</strong> <%= error %></p>
      <button type="button" class="link-btn" data-fragment-retry>Coba lagi</button></div>
  </div>
<% } else if (data.empty) { %>
  <div class="state state-inline"><%- icon('info') %><p>Belum ada data kualitas udara untuk lokasi ini. Status tidak ditampilkan sampai data tersedia.</p></div>
<% } else {
  const tone = data.category ? data.category.tone : 'none';
  const catIcon = { good: 'smile', moderate: 'info', none: 'info' }[tone] || 'alert'; %>
  <div class="aq tone-<%= tone %>">
    <span class="aq-num"><%= data.aqi != null ? Math.round(data.aqi) : '—' %></span>
    <div>
      <span class="aq-cat"><%- icon(catIcon, 20) %> <%= data.category ? data.category.label : 'Kategori tidak tersedia' %></span>
      <p class="small muted" style="margin:6px 0 0"><%= data.indexName %> · PM2.5 <%= data.params[0].value ?? '—' %> <%= data.params[0].unit %></p>
    </div>
    <div class="aq-meta">
      <span><%- icon('location', 16) %> <%= loc.label %></span>
      <span><%- icon('clock', 16) %> <%= data.dataTime ? data.dataTime.slice(11, 16) + ' ' + (data.tzAbbr || '') : '—' %></span>
      <% if (loc.kind === 'demo' || loc.kind === 'land-demo') { %><span class="badge badge-demo">Lokasi Demo</span><% } %>
    </div>
  </div>
  <% if (data.stale || (typeof warning !== 'undefined' && warning)) { %><p class="small warn" style="margin:var(--s-3) 0 0"><%- icon('alert', 16) %> Data lama — diambil <%= u.fmtDate(data.fetchedAt, true) %>.</p><% } %>
  <p class="xs muted" style="margin:var(--s-3) 0 0">Estimasi wilayah dari model, bukan sensor di lahan. Sumber: Open-Meteo &amp; CAMS.</p>
<% } %>
