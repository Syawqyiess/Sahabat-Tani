<% if (typeof error !== 'undefined' && error) { %>
  <div class="state state-inline state-error" role="status">
    <%- icon('alert') %>
    <div><p><strong>Informasi kualitas udara belum tersedia.</strong> <%= error %></p>
      <button type="button" class="link-btn" data-fragment-retry>Coba lagi</button></div>
  </div>
<% } else if (data.empty) { %>
  <div class="state state-inline"><%- icon('info') %><p>Belum ada data kualitas udara untuk lokasi ini. Status tidak ditampilkan sampai data tersedia.</p></div>
<% } else {
  const tone = data.category ? data.category.tone : 'none';
  const catIcon = { good: 'smile', moderate: 'info', none: 'info' }[tone] || 'alert';
  const advice = {
    good: 'Udara bersih & prima untuk pemupukan atau penyemprotan.',
    moderate: 'Cukup bersahabat; hindari paparan terik saat siang hari.',
    usg: 'Kurang ideal untuk semprot daun; utamakan pagi hari.',
    unhealthy: 'Hindari semprot pestisida hari ini; gunakan masker di sawah.',
    very: 'Kualitas udara buruk; batasi kegiatan luar ruang berkepanjangan.',
    hazard: 'Bahaya paparan udara; tunda pekerjaan fisik berat di sawah.'
  }[tone] || 'Pantau perubahan cuaca berkala.'; %>
  <div class="aq-card-inner tone-<%= tone %>">
    <div class="aq-primary-row">
      <div class="aq-figure">
        <span class="aq-num"><%= data.aqi != null ? Math.round(data.aqi) : '—' %></span>
        <span class="aq-scale-label">US AQI</span>
      </div>
      <div class="aq-status-wrap">
        <span class="aq-cat-pill">
          <%- icon(catIcon, 15) %> <%= data.category ? data.category.label : 'Kategori tidak tersedia' %>
        </span>
        <span class="aq-param-pill"><strong>PM2.5</strong> <%= data.params && data.params[0] && data.params[0].value != null ? data.params[0].value : '—' %> <%= data.params && data.params[0] && data.params[0].unit ? data.params[0].unit : 'µg/m³' %></span>
      </div>
    </div>

    <div class="aq-field-advisory">
      <span class="advisory-badge"><%- icon('leaf', 13) %> Rekomendasi Tani</span>
      <span class="advisory-text"><%= advice %></span>
    </div>

    <div class="aq-meta-bar">
      <span class="aq-meta-item"><%- icon('location', 14) %> <%= loc.label %></span>
      <span class="aq-meta-item"><%- icon('clock', 14) %> <%= data.dataTime ? data.dataTime.slice(11, 16) + ' ' + (data.tzAbbr || 'WIB') : '—' %></span>
      <% if (loc.kind === 'demo' || loc.kind === 'land-demo') { %><span class="badge badge-demo badge-xs">Demo</span><% } %>
    </div>

    <% if (data.stale || (typeof warning !== 'undefined' && warning)) { %>
      <p class="small warn" style="margin: 4px 0 0;"><%- icon('alert', 14) %> Data lama (<%= u.fmtDate(data.fetchedAt, true) %>)</p>
    <% } %>

    <p class="aq-footnote">Estimasi wilayah model Open-Meteo &amp; CAMS.</p>
  </div>
<% } %>
