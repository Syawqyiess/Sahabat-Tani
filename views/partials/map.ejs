<%
  // Data peta hanya berisi lahan milik petani yang sedang masuk (disiapkan di route).
  const allDemo = lands.length > 0 && lands.every((l) => l.data_source === 'demo');
  const mapLands = lands.map((l) => {
    const age = crop.cropAge(l);
    return {
      id: l.id, name: l.name, lat: l.lat, lng: l.lng, polygon: l.polygon || null, demo: l.data_source === 'demo', allDemo,
      area: l.area_ha != null ? crop.fmtHa(l.area_ha) : null, crop: l.commodity, address: l.address_desc,
      age: crop.phaseAgeLabel(age) || age.label, ageEstimated: age.phaseEstimated,
    };
  });
  const geoLands = mapLands.filter((l) => (l.lat != null && l.lng != null) || l.polygon);
  const compact = typeof compactMap !== 'undefined' && compactMap;
%>
<div class="map-wrap <%= compact ? 'map-compact' : '' %>">
  <% if (geoLands.some((l) => l.demo)) { %>
    <p class="map-label"><span class="badge badge-demo">Lahan Demo — Bukan Batas Lahan Asli</span></p>
  <% } %>
  <% if (geoLands.length) { %>
    <link rel="stylesheet" href="/static/vendor/leaflet/leaflet.css">
    <div class="map" id="map"
      data-center="<%= JSON.stringify(maps.demoCenter) %>"
      data-lands="<%= JSON.stringify(geoLands) %>"
      data-selected="<%= typeof selected !== 'undefined' && selected ? selected : '' %>"
      role="region" aria-label="Peta lahan (gunakan tombol plus/minus untuk memperbesar)">
      <div class="state-inline" style="background:transparent"><span class="spinner" aria-hidden="true"></span> Memuat peta…</div>
    </div>
    <div class="map-legend" aria-label="Legenda peta">
      <% if (geoLands.some((l) => !l.demo)) { %><span class="legend-item"><span class="legend-swatch legend-real"></span> Lahan asli — garis penuh, penanda L</span><% } %>
      <% if (geoLands.some((l) => l.demo)) { %><span class="legend-item"><span class="legend-swatch legend-demo"></span> Lahan demo — garis putus-putus, penanda D</span><% } %>
    </div>
    <p class="map-tile-msg small warn" data-map-msg role="status" hidden></p>
    <noscript><p class="notice">Peta membutuhkan JavaScript. Koordinat lahan tetap bisa dilihat di halaman detail lahan.</p></noscript>
    <script src="/static/vendor/leaflet/leaflet.js" defer></script>
    <script src="<%= asset('js/map.js') %>" defer></script>
  <% } else { %>
    <div class="map-placeholder" role="note">
      <%- include('terrace', { variant: 'soft' }) %>
      <p style="display:flex;gap:10px;align-items:flex-start"><%- icon('map', 26) %> <span><strong>Belum ada lahan berkoordinat.</strong> Isi lintang dan bujur (atau batas lahan) di halaman ubah lahan agar lahan tampil di peta.</span></p>
    </div>
  <% } %>
</div>
