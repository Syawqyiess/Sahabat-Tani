<%
  const mins = a.origin === 'internal' ? u.readMinutes(a.body_md) : null;
  const featured = typeof feature !== 'undefined' && feature;
%>
<article class="article-card <%= featured ? 'article-featured' : '' %>">
  <div class="article-media">
    <%- include('article-media', { a, main: featured }) %>
  </div>
  <div class="article-body">
    <div class="badges">
      <% if (a.category_name) { %><span class="badge"><%= a.category_name %></span><% } %>
      <% if (a.is_demo) { %><span class="badge badge-demo">Konten Demo</span><% } %>
      <% if (a.origin === 'external') { %><span class="badge badge-ext badge-1line" title="Berita dari <%= a.source_name %>">Berita · <%= a.source_name %></span><% } %>
    </div>
    <h3><a href="/artikel/<%= a.slug %>"><%= a.title %></a></h3>
    <% if (a.summary) { %><p><%= a.summary %></p><% } %>
    <div class="article-meta">
      <% if (a.published_at) { %><span><%= u.fmtDate(a.published_at) %></span><% } else { %><span>Tanggal tidak tersedia</span><% } %>
      <% if (a.origin === 'external') { %><span><%- icon('external', 14) %> <%= a.source_name %></span><% } %>
      <% if (mins) { %><span><%- icon('clock', 16) %> <%= mins %> menit baca</span><% } %>
    </div>
  </div>
  <% if (typeof saved !== 'undefined' && saved) { %>
    <form method="post" action="/artikel/<%= a.id %>/simpan">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="back" value="<%= typeof back !== 'undefined' ? back : '/artikel' %>">
      <button class="btn btn-sm <%= saved.has(a.id) ? 'btn-tonal' : 'btn-ghost' %>" type="submit"><%- icon('bookmark', 18) %> <%= saved.has(a.id) ? 'Tersimpan — hapus' : 'Simpan' %></button>
    </form>
  <% } %>
</article>
