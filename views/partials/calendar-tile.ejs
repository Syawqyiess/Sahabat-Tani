<%
  // Kartu Dashboard "Kalender Tanam": pratinjau kegiatan tanam hari ini (Asia/Jakarta)
  const c = calendar;
  const [dayName, rest] = c.todayLabel.split(', ');
  const href = '/kalender-tanam?' + (c.land ? 'lahan=' + c.land.id + '&' : '') + 'tanggal=' + c.today;
%>
<div class="tile tile-cal">
  <div class="tile-head">
    <div class="cal-head-left">
      <span class="tile-head-title"><%- icon('clock', 18) %> Kalender Tanam</span>
      <span class="cal-mini-date-badge" title="Tanggal hari ini: <%= Number(c.today.slice(8)) %>"><%= Number(c.today.slice(8)) %></span>
    </div>
    <a href="<%= href %>" class="action-circle-sm" title="Buka Kalender Tanam" aria-label="Buka Kalender Tanam">↗</a>
  </div>

  <% if (c.land && lands.length > 1) { %>
    <div class="cal-selector-bar">
      <form method="get" action="/dashboard" class="cal-select-form">
        <%- icon('field', 14) %>
        <label for="cal-tile-land" class="visually-hidden">Pilih lahan</label>
        <select id="cal-tile-land" name="kalender" data-autosubmit-select class="cal-select-inline">
          <% lands.forEach((l) => { %>
            <option value="<%= l.id %>" <%= c.land.id === l.id ? 'selected' : '' %>><%= l.name %></option>
          <% }) %>
        </select>
      </form>
      <% if (c.age && c.age.status === 'growing') { %>
        <span class="cal-hst-tag"><%= c.age.days %> HST<%= c.age.phase ? ' · ' + c.age.phase : '' %></span>
      <% } %>
    </div>
  <% } else if (c.land) { %>
    <div class="cal-land-single-bar">
      <span class="cal-land-name"><%- icon('field', 14) %> <%= c.land.name %></span>
      <% if (c.age && c.age.status === 'growing') { %>
        <span class="cal-hst-tag"><%= c.age.days %> HST<%= c.age.phase ? ' · ' + c.age.phase : '' %></span>
      <% } %>
    </div>
  <% } %>

  <div class="cal-date-row">
    <span class="cal-date-text"><strong><%= dayName %></strong>, <%= rest %></span>
  </div>

  <div class="cal-activity-card">
    <% if (!c.land) { %>
      <div class="cal-empty-state">
        <p class="small muted" style="margin:0;">Tambahkan lahan untuk mengatur kegiatan tanam.</p>
      </div>
    <% } else if (!c.items.length) { %>
      <div class="cal-empty-state">
        <%- icon('calendar', 16) %>
        <span>Tidak ada jadwal kegiatan hari ini</span>
      </div>
    <% } else { %>
      <ul class="cal-today-list" role="list">
        <% c.items.forEach((r) => { %>
          <li class="<%= r.done_at ? 'is-done' : '' %>">
            <% if (r.done_at) { %><span class="cal-today-check" title="Selesai"><%- icon('check', 14) %></span><% } %>
            <span class="cal-today-item" title="<%= r.title %>"><%= r.title %></span>
            <span class="badge cat-<%= r.category %>"><%= r.categoryLabel %></span>
          </li>
        <% }) %>
      </ul>
      <% if (c.more) { %><p class="cal-today-more">+<%= c.more %> kegiatan lainnya</p><% } %>
    <% } %>
  </div>

  <a class="tile-go" href="<%= href %>">
    Lihat Kalender Lengkap <%- icon('arrowRight', 16) %>
  </a>
</div>
