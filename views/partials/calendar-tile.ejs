<%
  // Kartu Dashboard "Kalender Tanam": pratinjau kegiatan tanam hari ini (Asia/Jakarta)
  const c = calendar;
  const [dayName, rest] = c.todayLabel.split(', ');
  const monthYear = rest.replace(/^\d+ /, '');
  const href = '/kalender-tanam?' + (c.land ? 'lahan=' + c.land.id + '&' : '') + 'tanggal=' + c.today;
  const summary = c.land ? (c.total ? c.total + ' kegiatan hari ini' : 'belum ada kegiatan hari ini') : 'belum ada lahan';
%>
<div class="cal-today-wrap<%= c.land && lands.length > 1 ? ' has-pick' : '' %>">
  <a class="tile cal-today" href="<%= href %>" data-cal-today="<%= c.today %>"
     aria-label="Kalender Tanam, <%= c.todayLabel %><%= c.land ? ', ' + c.land.name : '' %>: <%= summary %>. Lihat kalender lengkap">
    <div class="cal-today-head">
      <div class="cal-head-left">
        <span class="cal-today-title"><%- icon('calendar', 18) %> Kalender Tanam</span>
        <p class="cal-today-date"><strong><%= dayName %></strong>, <%= monthYear %></p>
      </div>
      <span class="cal-date-circle" aria-hidden="true"><%= Number(c.today.slice(8)) %></span>
    </div>

    <% if (!c.land) { %>
      <div class="cal-activity-card">
        <div class="cal-empty-state">
          <p class="small muted" style="margin:0;">Tambahkan lahan untuk mengatur kegiatan tanam.</p>
        </div>
      </div>
    <% } else { %>
      <div class="cal-today-land-bar">
        <span class="cal-today-land"><%- icon('field', 14) %> <strong><%= c.land.name %></strong></span>
        <% if (c.age && c.age.status === 'growing') { %>
          <span class="cal-today-hst"><%= c.age.days %> HST<%= c.age.phase ? ' · ' + c.age.phase : '' %></span>
        <% } %>
      </div>

      <div class="cal-activity-card">
        <% if (!c.items.length) { %>
          <div class="cal-empty-state">
            <div class="cal-empty-check"><%- icon('check', 16) %></div>
            <div class="cal-empty-content">
              <strong>Belum ada kegiatan hari ini</strong>
              <span>Semua tugas beres. Pantau pertumbuhan tanaman.</span>
            </div>
          </div>
        <% } else { %>
          <ul class="cal-today-list" role="list">
            <% c.items.forEach((r) => { %>
              <li class="<%= r.done_at ? 'is-done' : '' %>">
                <% if (r.done_at) { %><span class="cal-today-check" title="Selesai"><%- icon('check', 14) %></span><% } %>
                <span class="cal-today-item" title="<%= r.title %>"><%= r.title %></span>
                <span class="badge cat-<%= r.category %>"><%= r.categoryLabel %></span>
              </li>
            <% }) %>
          </ul>
          <% if (c.more) { %><p class="cal-today-more">+<%= c.more %> kegiatan lainnya</p><% } %>
        <% } %>
      </div>
    <% } %>

    <span class="tile-go">
      Lihat Kalender Lengkap <%- icon('arrowRight', 16) %>
    </span>
  </a>

  <% if (c.land && lands.length > 1) { %>
    <form method="get" action="/dashboard" class="cal-today-pick">
      <label for="cal-tile-land" class="visually-hidden">Pilih lahan untuk Kalender Tanam</label>
      <select id="cal-tile-land" name="kalender" data-autosubmit-select>
        <% lands.forEach((l) => { %><option value="<%= l.id %>" <%= c.land.id === l.id ? 'selected' : '' %>><%= l.name %></option><% }) %>
      </select>
      <noscript><button class="btn btn-sm" type="submit">Pilih</button></noscript>
    </form>
  <% } %>
</div>
