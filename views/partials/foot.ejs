    </main>
<%
  // Tombol chat mengambang: hanya untuk petani, tidak di chatroom/scanner (mengganggu tindakan utama).
  const showFab = currentUser && currentUser.role === 'farmer' && !/^\/(asisten|scan)(\/|$)/.test(path);
%>
<% if (typeof layout === 'undefined' || layout !== 'chat') { %><%- include('site-footer', { withFab: showFab }) %><% } %>
  </div>
</div>
<% if (showFab) { %>
  <div class="fab" data-fab>
    <div class="fab-menu" id="fab-menu" hidden>
      <a class="fab-action" href="/asisten"><span class="fab-ic"><%- icon('chat', 20) %></span><span><strong>Tanya Asisten AI</strong><small>Mulai percakapan baru</small></span></a>
      <a class="fab-action fab-action-scan" href="/scan"><span class="fab-ic"><%- icon('camera', 20) %></span><span><strong>Scan Hama</strong><small>Foto gejala pada tanaman</small></span></a>
    </div>
    <button type="button" class="fab-btn" data-fab-toggle aria-expanded="false" aria-controls="fab-menu" aria-label="Bantuan cepat: Asisten AI dan Scan Hama">
      <span class="fab-open"><%- icon('chat', 26) %></span><span class="fab-close" hidden><%- icon('close', 24) %></span>
    </button>
  </div>
<% } %>
</body>
</html>
