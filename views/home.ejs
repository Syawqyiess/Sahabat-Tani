<%- include('partials/head') %>
<section class="hero bento-hero agri-hero">
  <div class="hero-content">
    <div class="hero-badge-row">
      <span class="pill-badge agri-hero-pill">
        <%- icon('leaf', 16) %> Modern AgriTech Padi
      </span>
      <span class="hero-subbadge">Teman Bertani Digital Indonesia</span>
    </div>
    <h1>Teman setia di sawah, dari deteksi hama hingga panen raya.</h1>
    <p class="lead">Foto tanaman padi yang bergejala langsung di sawah, kenali hamanya dengan AI, dan konsultasikan penanganannya secara terpadu — cepat, tepat, dan mudah dari ponsel Anda.</p>
    <div class="hero-cta">
      <a class="btn btn-lg btn-scan btn-pill" href="/daftar">
        <span>Daftar Gratis</span>
        <span class="action-circle-sm">↗</span>
      </a>
      <a class="btn btn-lg btn-ghost btn-pill" href="/masuk">Saya sudah punya akun</a>
    </div>
    <div class="hero-stats-row">
      <div class="hero-stat-pill">
        <span class="stat-bullet"></span>
        <span>14 Spesies Hama Padi</span>
      </div>
      <div class="hero-stat-pill">
        <span class="stat-bullet"></span>
        <span>Kualitas Udara Real-Time</span>
      </div>
      <div class="hero-stat-pill">
        <span class="stat-bullet"></span>
        <span>Kalender Tanam &amp; HST</span>
      </div>
    </div>
  </div>
  <div class="hero-visual-card">
    <div class="hero-art-photo">
      <img src="/static/img/lahan-demo/blok-a.webp" alt="Sawah padi hijau terasering Indonesia" class="hero-img-cover" fetchpriority="high">
      <div class="hero-art-gradient"></div>
      <div class="hero-art-overlay-card">
        <div class="ha-card-top">
          <span class="ha-badge"><%- icon('camera', 16) %> AI Scanner Padi</span>
          <span class="ha-status">Akurasi 86%+</span>
        </div>
        <p class="ha-card-text">Deteksi otomatis wereng, penggerek batang, ulat grayak, dan hama utama lainnya.</p>
      </div>
    </div>
  </div>
</section>

<div class="section-head" style="margin-top: var(--s-10);">
  <span class="tag-caption">LANGKAH MUDAH</span>
  <h2 class="h3">Cara kerjanya</h2>
</div>
<ol class="steps-line">
  <li><div class="bento-step"><span class="step-num">01</span><h3>Foto bagian yang bergejala</h3><p>Pakai kamera ponsel atau pilih foto dari galeri.</p></div></li>
  <li><div class="bento-step"><span class="step-num">02</span><h3>Dapatkan dugaan awal</h3><p>Ciri yang terlihat di foto dijelaskan dengan bahasa sederhana.</p></div></li>
  <li><div class="bento-step"><span class="step-num">03</span><h3>Lanjut tanya Asisten AI</h3><p>Foto dan hasilnya sudah ada di percakapan — tidak perlu unggah ulang.</p></div></li>
</ol>

<div class="section-head" style="margin-top: var(--s-10);">
  <span class="tag-caption">FITUR UNGGULAN</span>
  <h2 class="h3">Yang bisa Anda lakukan</h2>
</div>
<div class="feature-list bento-grid">
  <div class="feature bento-card"><div class="bento-card-head"><span class="ic-wrap"><%- icon('field', 24) %></span><span class="action-circle">↗</span></div><h3>Catat lahan</h3><p>Luas, varietas, tanggal tanam, dan lokasi di peta bila koordinat tersedia.</p></div>
  <div class="feature bento-card"><div class="bento-card-head"><span class="ic-wrap"><%- icon('air', 24) %></span><span class="action-circle">↗</span></div><h3>Pantau kualitas udara</h3><p>Estimasi wilayah dari Open-Meteo untuk menjaga kesehatan saat bekerja di sawah.</p></div>
  <div class="feature bento-card"><div class="bento-card-head"><span class="ic-wrap"><%- icon('article', 24) %></span><span class="action-circle">↗</span></div><h3>Baca dan simpan artikel</h3><p>Budidaya, pemupukan, dan hama — simpan yang penting untuk dibaca lagi.</p></div>
  <div class="feature bento-card"><div class="bento-card-head"><span class="ic-wrap"><%- icon('chat', 24) %></span><span class="action-circle">↗</span></div><h3>Riwayat tersimpan</h3><p>Scan dan percakapan tetap ada setelah keluar dan masuk lagi.</p></div>
  <div class="feature bento-card"><div class="bento-card-head"><span class="ic-wrap"><%- icon('shield', 24) %></span><span class="action-circle">↗</span></div><h3>Data pribadi terjaga</h3><p>Foto dan percakapan hanya bisa dilihat pemilik akunnya.</p></div>
  <div class="feature bento-card"><div class="bento-card-head"><span class="ic-wrap"><%- icon('users', 24) %></span><span class="action-circle">↗</span></div><h3>Didampingi admin</h3><p>Admin dan penyuluh bisa membantu melengkapi profil dan data lahan.</p></div>
</div>

<% if (latest.length) { %>
<section class="section" style="margin-top: var(--s-10);">
  <div class="section-head">
    <div>
      <span class="tag-caption">EDUKASI PETANI</span>
      <h2 class="h3">Bacaan terbaru</h2>
    </div>
    <a href="/artikel" class="btn btn-sm btn-ghost btn-pill">Semua artikel ↗</a>
  </div>
  <div class="article-grid">
    <% latest.forEach((a) => { %><%- include('partials/article-card', { a, saved: null }) %><% }) %>
  </div>
</section>
<% } %>

<p class="notice" style="margin-top: var(--s-8);"><%- icon('info') %> <span>Ini versi demo. Hasil identifikasi foto bersifat dugaan awal dan tidak menggantikan pemeriksaan penyuluh pertanian.</span></p>
<%- include('partials/foot') %>
