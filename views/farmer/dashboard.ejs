<%- include('../partials/head') %>
<%
  const name = (profile.full_name || '').replace(/\s*\(.*\)\s*$/, '').trim() || 'Petani';
  const hour = new Date().getHours();
  const greeting = hour < 11 ? 'Selamat Pagi' : hour < 15 ? 'Selamat Siang' : hour < 18 ? 'Selamat Sore' : 'Selamat Malam';
%>
<section class="welcome welcome-agri" aria-labelledby="sapaan">
  <div class="welcome-backdrop" aria-hidden="true">
    <img src="/static/img/lahan-demo/blok-a.webp" alt="" class="welcome-bg-img" fetchpriority="high">
    <div class="welcome-overlay"></div>
    <div class="welcome-contour"></div>
  </div>
  <div class="welcome-content">
    <div class="welcome-text">
      <div class="welcome-badge-row">
        <span class="agri-pill-tag">
          <span class="live-pulse" aria-hidden="true"></span>
          <%- icon('leaf', 14) %> Musim Tanam Padi
        </span>
        <span class="welcome-date"><%- icon('clock', 13) %> <%= calendar.todayLabel %></span>
      </div>
      <h1 id="sapaan"><%= greeting %>, <%= name %>! 👋</h1>
      <p class="welcome-sub">Telemetri lahan aktif &middot; Deteksi dini gejala hama padi &middot; Jadwal tanam presisi.</p>
      <div class="welcome-actions">
        <a class="btn btn-scan btn-lg" href="/scan">
          <%- icon('camera', 22) %>
          <span>Scan Hama Padi</span>
          <span class="action-circle-sm">↗</span>
        </a>
        <a class="btn btn-ghost btn-lg" href="/lahan">
          <%- icon('field', 20) %> Lihat Lahan Saya
        </a>
      </div>
    </div>

    <div class="welcome-side-card" aria-hidden="true">
      <div class="agro-glass-card">
        <div class="agro-glass-head">
          <span class="agro-glass-title"><%- icon('leaf', 16) %> Status Tanaman Aktif</span>
          <span class="agro-glass-status"><span class="status-pulse-dot"></span> Terpantau</span>
        </div>
        <div class="agro-glass-grid">
          <% if (calendar.land && calendar.age && calendar.age.status === 'growing') { %>
            <div class="agro-item">
              <span class="agro-val"><%= calendar.age.days %> <small>HST</small></span>
              <span class="agro-lbl">Hari Setelah Tanam</span>
            </div>
            <div class="agro-item">
              <span class="agro-val"><%= calendar.age.phase || 'Vegetatif' %></span>
              <span class="agro-lbl">Fase Pertumbuhan</span>
            </div>
            <div class="agro-item agro-item-full">
              <div class="agro-crop-status">
                <span class="crop-phase-pill"><%- icon('field', 14) %> <%= calendar.land.name %></span>
                <span class="crop-phase-name"><%= calendar.items && calendar.items.length ? calendar.items.length + ' agenda kerja hari ini' : 'Agenda hari ini siap dikerjakan' %></span>
              </div>
            </div>
          <% } else if (calendar.land) { %>
            <div class="agro-item">
              <span class="agro-val"><%= calendar.land.crop_type || 'Padi' %></span>
              <span class="agro-lbl">Komoditas Lahan</span>
            </div>
            <div class="agro-item">
              <span class="agro-val">Siap</span>
              <span class="agro-lbl">Musim Tanam</span>
            </div>
            <div class="agro-item agro-item-full">
              <div class="agro-crop-status">
                <span class="crop-phase-pill"><%- icon('field', 14) %> <%= calendar.land.name %></span>
                <span class="crop-phase-name">Lahan aktif siap pencatatan tanam</span>
              </div>
            </div>
          <% } else { %>
            <div class="agro-item">
              <span class="agro-val">0</span>
              <span class="agro-lbl">Petak Terdaftar</span>
            </div>
            <div class="agro-item">
              <span class="agro-val">Siap</span>
              <span class="agro-lbl">Mulai Catat</span>
            </div>
            <div class="agro-item agro-item-full">
              <div class="agro-crop-status">
                <span class="crop-phase-pill">🌱 Selamat Datang</span>
                <span class="crop-phase-name">Tambahkan lahan pertama Anda untuk pantauan cerdas</span>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<nav class="dash-quick-bar" aria-label="Aksi Cepat">
  <a class="quick-pill quick-pill-primary" href="/scan">
    <%- icon('camera', 18) %>
    <span>Scan Hama</span>
  </a>
  <a class="quick-pill" href="/asisten">
    <%- icon('chat', 18) %>
    <span>Tanya AI</span>
  </a>
  <a class="quick-pill" href="/kalender-tanam<%= calendar.land ? '?lahan=' + calendar.land.id : '' %>">
    <%- icon('calendar', 18) %>
    <span>Jadwal Tanam</span>
  </a>
  <a class="quick-pill" href="/lahan">
    <%- icon('field', 18) %>
    <span>Lahan Saya</span>
  </a>
</nav>

<% if (completeness.percent < 100) { %>
  <div class="nudge">
    <div class="progress" role="progressbar" aria-valuenow="<%= completeness.percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="Kelengkapan profil"><span style="width: <%= completeness.percent %>%"></span></div>
    <p><strong>Profil <%= completeness.percent %>% lengkap.</strong> Belum diisi: <%= completeness.missing.join(', ') %>.</p>
    <a class="btn btn-sm" href="/profil/ubah"><%- icon('edit', 18) %> Lengkapi Profil</a>
  </div>
<% } %>

<section class="summary" aria-label="Ringkasan">
  <%- include('../partials/calendar-tile', { calendar, lands }) %>

  <div class="tile tile-air">
    <div class="tile-head">
      <span class="tile-head-title"><%- icon('air', 20) %> Kualitas Udara</span>
      <a href="/udara<%= airLand ? '?lahan=' + airLand.id : '' %>" class="action-circle-sm" title="Buka detail kualitas udara" aria-label="Buka detail kualitas udara">↗</a>
    </div>
    <div data-fragment="/udara/ringkas<%= airLand ? '?lahan=' + airLand.id : '' %>" aria-busy="true">
      <div class="aq-card-inner" aria-hidden="true">
        <div class="skeleton sk-num" style="width: 100px; height: 44px; border-radius: 12px;"></div>
        <div class="skeleton sk-line" style="width: 140px; height: 26px; border-radius: 9999px; margin-top: 8px;"></div>
        <div class="skeleton sk-line" style="width: 180px; height: 18px; margin-top: 8px;"></div>
      </div>
      <span class="visually-hidden">Memuat informasi kualitas udara…</span>
      <noscript><a href="/udara">Lihat informasi kualitas udara</a></noscript>
    </div>
    <a class="tile-go" href="/udara<%= airLand ? '?lahan=' + airLand.id : '' %>">
      Lihat Detail Udara <%- icon('arrowRight', 16) %>
    </a>
  </div>

  <a class="tile tile-land" href="/lahan">
    <div class="tile-head">
      <span class="tile-head-title"><%- icon('field', 20) %> Lahan Saya</span>
      <span class="action-circle-sm" aria-hidden="true">↗</span>
    </div>
    <div class="tile-stats-bento">
      <div class="stat-box">
        <span class="big-num"><%= summary.count %></span>
        <span class="stat-label">Petak Lahan</span>
      </div>
      <div class="stat-box">
        <div class="stat-val-row">
          <span class="big-num"><%= summary.totalArea != null ? summary.totalLabel.replace(' ha', '') : '—' %></span>
          <span class="stat-unit">ha</span>
        </div>
        <span class="stat-label">Total Luas</span>
      </div>
    </div>
    <div class="tile-info-row">
      <% if (!summary.count) { %>
        <span class="pill-info-tag">Belum ada lahan — tambah lahan</span>
      <% } else if (summary.demoCount) { %>
        <span class="pill-info-tag"><span class="badge badge-demo badge-xs">Data Demo</span> <%= summary.demoCount %> lahan contoh</span>
      <% } else if (summary.noArea) { %>
        <span class="pill-info-tag"><%= summary.noArea %> lahan belum diisi luas</span>
      <% } else { %>
        <span class="pill-info-tag"><%- icon('check', 14) %> Semua data aktif</span>
      <% } %>
    </div>
    <span class="tile-go"><%= summary.count ? 'Kelola Lahan' : 'Tambah Lahan' %> <%- icon('arrowRight', 16) %></span>
  </a>
</section>

<div class="dash-main">
  <section class="panel panel-map-card" aria-labelledby="peta-judul">
    <div class="section-head"><h2 class="h3" id="peta-judul"><%- icon('map') %> Peta Lahan</h2><% if (lands.length) { %><a href="/lahan/peta">Buka peta penuh</a><% } %></div>
    <% if (lands.length) { %>
      <%- include('../partials/map', { compactMap: true, selected: null }) %>
    <% } else { %>
      <%- include('../partials/empty', { heading: 'Belum ada lahan', text: 'Catat lahan Anda. Luas dan koordinat boleh diisi nanti.', actions: [{ href: '/lahan/baru', label: 'Tambahkan Lahan', icon: 'plus' }] }) %>
    <% } %>
  </section>

  <div class="dash-side">
    <section class="panel" aria-labelledby="riwayat-judul">
      <div class="section-head"><h2 class="h3" id="riwayat-judul"><%- icon('history') %> Riwayat Scan</h2><a href="/scan/riwayat">Semua</a></div>
      <% if (scans.length) { %>
        <ul class="scan-list"><% scans.slice(0, 3).forEach((s) => { %><%- include('../partials/scan-item', { s }) %><% }) %></ul>
      <% } else { %>
        <p class="muted" style="margin:0">Hasil scan akan tersimpan di sini.</p>
      <% } %>
    </section>

    <section class="panel" aria-labelledby="chat-judul">
      <div class="section-head"><h2 class="h3" id="chat-judul"><%- icon('chat') %> Asisten AI</h2><a href="/asisten/riwayat">Riwayat percakapan</a></div>
      <% if (lastChat) { %>
        <%
          let cleanMsg = u.stripHtml(lastChat.last_message || '');
          cleanMsg = cleanMsg.replace(/^(halo\s+(bapak\/ibu\s+)?petani!?\s*|halo!?\s*|selamat\s+(pagi|siang|sore|malam)!?\s*)/i, '');
          cleanMsg = u.truncate(cleanMsg, 115);
        %>
        <a class="continue-chat" href="/asisten/<%= lastChat.id %>#akhir">
          <span class="ic-wrap"><%- icon('chat', 20) %></span>
          <span class="grow">
            <span class="chat-chip-meta">
              <span class="chat-topic-tag"><%- icon('chat', 12) %> Topik Aktif</span>
              <span class="xs muted"><%= u.timeAgo(lastChat.updated_at) %></span>
            </span>
            <strong><%= lastChat.title %></strong>
            <p><%= cleanMsg %></p>
          </span>
        </a>
      <% } else { %>
        <p class="muted">Belum ada percakapan. Hasil scan otomatis membuka percakapan baru.</p>
      <% } %>
    </section>
  </div>
</div>

<%- include('../partials/rdkk', { rdkk }) %>

<section class="section" aria-labelledby="artikel-judul">
  <div class="section-head"><h2 id="artikel-judul">Bacaan untuk Anda</h2><a href="/artikel">Semua artikel</a></div>
  <% if (articles.length) { %>
    <div class="article-grid dash-articles"><% articles.forEach((a) => { %><%- include('../partials/article-card', { a, saved: null }) %><% }) %></div>
  <% } else { %><p class="muted">Belum ada artikel.</p><% } %>
</section>
<%- include('../partials/foot') %>
