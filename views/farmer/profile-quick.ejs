<%- include('../partials/head') %>
<article class="info-page">
  <h1>Lengkapi profil singkat</h1>
  <p class="muted">Semua kolom boleh dikosongkan dan dilengkapi nanti di Profil Saya.</p>
  <form method="post" action="/profil/lengkapi" class="form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/field', { name: 'phone', label: 'Nomor HP', type: 'tel', inputmode: 'tel', value: values.phone, error: errors.phone, autocomplete: 'tel', optional: true, placeholder: '0812xxxxxxx', hint: 'Dipakai untuk masuk dengan nomor HP dan dihubungi penyuluh.' }) %>
    <%- include('../partials/field', { name: 'village', label: 'Desa/kelurahan', value: values.village, error: errors.village, optional: true }) %>
    <%- include('../partials/field', { name: 'farmer_group', label: 'Kelompok tani', value: values.farmer_group, error: errors.farmer_group, optional: true }) %>
    <div class="row wrap-row">
      <button class="btn" type="submit" data-busy="Menyimpan…"><%- icon('check', 18) %> Simpan</button>
      <a class="btn btn-ghost" href="/dashboard">Lewati, lengkapi nanti</a>
    </div>
  </form>
</article>
<%- include('../partials/foot') %>
