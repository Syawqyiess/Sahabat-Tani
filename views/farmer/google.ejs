<%- include('../partials/head') %>
<article class="info-page">
  <a class="back-link" href="/profil"><%- icon('arrowLeft', 18) %> Profil Saya</a>
  <h1>Metode masuk</h1>
  <p class="muted">Atur cara masuk ke akun Sahabat Tani Anda.</p>

  <section class="login-methods" aria-label="Metode masuk">
    <div class="lm-row">
      <span class="lm-ic"><%- icon('shield', 20) %></span>
      <div class="lm-main"><strong>Nomor HP/email &amp; kata sandi</strong>
        <span class="small muted"><%= hasPassword ? 'Aktif' : 'Belum ada kata sandi — akun ini dibuat dengan Google.' %></span></div>
      <span class="badge <%= hasPassword ? 'badge-real' : 'badge-muted' %>"><%= hasPassword ? 'Aktif' : 'Belum diatur' %></span>
    </div>
    <div class="lm-row">
      <span class="lm-ic lm-google" aria-hidden="true"><svg viewBox="0 0 48 48" width="20" height="20"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg></span>
      <div class="lm-main"><strong>Google</strong>
        <span class="small muted"><%= identity ? 'Terhubung' + (identity.email ? ' sebagai ' + identity.email : '') : 'Belum terhubung' %></span></div>
      <span class="badge <%= identity ? 'badge-real' : 'badge-muted' %>"><%= identity ? 'Google terhubung' : 'Belum terhubung' %></span>
    </div>
  </section>

  <% if (identity) { %>
    <% if (hasPassword) { %>
      <form method="post" action="/profil/google/putus" data-confirm="Putuskan Google dari akun ini? Anda tetap bisa masuk dengan nomor HP/email dan kata sandi.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-ghost" type="submit">Putuskan Google</button>
      </form>
    <% } else { %>
      <h2 class="h4">Buat kata sandi (opsional)</h2>
      <p class="small muted">Dengan kata sandi, Anda punya cara masuk kedua bila tidak bisa memakai Google. Google hanya dapat diputus setelah kata sandi dibuat.</p>
      <form method="post" action="/profil/google/sandi" class="form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="username" value="<%= currentUser.email || currentUser.phone || '' %>" autocomplete="username" hidden>
        <%- include('../partials/field', { name: 'password', label: 'Kata sandi baru', type: 'password', value: '', autocomplete: 'new-password', required: true, reveal: true, hint: 'Minimal 8 karakter.' }) %>
        <%- include('../partials/field', { name: 'password_confirm', label: 'Ulangi kata sandi', type: 'password', value: '', autocomplete: 'new-password', required: true, reveal: true }) %>
        <button class="btn" type="submit" data-busy="Menyimpan…">Simpan kata sandi</button>
      </form>
    <% } %>
  <% } else if (!googleEnabled) { %>
    <div class="alert alert-info"><%- icon('info') %><span>Masuk dengan Google belum diaktifkan oleh pengelola aplikasi.</span></div>
  <% } else { %>
    <h2 class="h4">Hubungkan Google</h2>
    <p class="small muted">Demi keamanan, masukkan kata sandi Sahabat Tani Anda terlebih dahulu. Setelah itu Anda diarahkan ke halaman resmi Google untuk memilih akun.</p>
    <form method="post" action="/auth/google" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="intent" value="link">
      <input type="text" name="username" value="<%= currentUser.email || currentUser.phone || '' %>" autocomplete="username" hidden>
      <%- include('../partials/field', { name: 'password', label: 'Kata sandi Sahabat Tani', type: 'password', value: '', autocomplete: 'current-password', required: true, reveal: true }) %>
      <button class="gsi-btn" type="submit" data-busy="Mengalihkan ke Google…">
        <span class="gsi-logo" aria-hidden="true"><svg viewBox="0 0 48 48" width="20" height="20" focusable="false"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg></span>
        <span class="gsi-text">Hubungkan dengan Google</span>
      </button>
    </form>
  <% } %>
</article>
<%- include('../partials/foot') %>
