{
  "name": "sahabat-tani",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem informasi pertanian untuk petani padi (demo fungsional)",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/tailwind.css --watch",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/migrate.js && node src/db/seed.js",
    "cek-ai": "node src/cek-ai.js",
    "uji-chatbot": "node src/uji-chatbot.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "backfill-gambar": "node src/backfill-gambar.js",
    "pindah-supabase": "node src/db/pindah-ke-supabase.js",
    "test:supabase": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "marked": "^18.1.2",
    "multer": "^2.5.0",
    "onnxruntime-node": "^1.31.1",
    "pg": "^8.23.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19"
  }
}
