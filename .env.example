# Salin menjadi .env lalu isi sesuai kebutuhan. JANGAN commit file .env.

# --- Aplikasi ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Wajib diganti di produksi (string acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
SESSION_SECRET=
# DB_PATH=./storage/sahabat-tani.db
# UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=8

# --- AI (Anthropic Claude) ---
# Kosongkan untuk MODE DEMO ("Simulasi respons AI", foto tidak dianalisis).
ANTHROPIC_API_KEY=
# Penyedia dipisah: analisis gambar vs percakapan (analisis gambar: lokal | gemini | anthropic | demo; percakapan: ollama | gemini | anthropic | demo)
# AI_VISION_PROVIDER=anthropic
# AI_CHAT_PROVIDER=anthropic
# AI_VISION_MODEL=claude-opus-5-5
# AI_CHAT_MODEL=claude-opus-5-5
# Fallback sisi server bila model menolak permintaan (true/false)
# AI_USE_FALLBACKS=true

# --- AI gratis untuk demo: Google Gemini (aistudio.google.com → Get API key) ---
# Cukup isi GEMINI_API_KEY; aplikasi otomatis memakai Gemini bila ANTHROPIC_API_KEY kosong.
# Catatan: pada free tier, Google dapat memakai data yang dikirim untuk meningkatkan produknya.
GEMINI_API_KEY=
# Daftar model dipisah koma, dicoba berurutan (default analisis foto: gemini-3.5-flash,gemini-flash-lite-latest;
# default chat: gemini-flash-lite-latest,gemini-3.5-flash). "npm run cek-ai" menampilkan model yang tersedia.
# GEMINI_VISION_MODEL=gemini-3.5-flash,gemini-flash-lite-latest
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest,gemini-3.5-flash
# Batas waktu per model (milidetik)
# GEMINI_TIMEOUT_MS=50000

# --- Chatbot lokal (Ollama, tanpa layanan luar; lihat docs/INTEGRASI.md) ---
# AI_CHAT_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_VISION=true
# OLLAMA_NUM_CTX=4096
# OLLAMA_TIMEOUT_MS=180000

# --- Model scanner buatan sendiri (lihat ml/README.md) ---
# AI_VISION_PROVIDER=lokal
# LOCAL_SCANNER_DIR=models/scanner-padi
# LOCAL_SCANNER_MIN_SCORE=0.6

# --- Google Maps JavaScript API (browser key, WAJIB dibatasi per domain) ---
GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_MAPS_MAP_ID=
# Lokasi demo peta & kualitas udara bila lahan belum berkoordinat
# DEMO_MAP_LAT=-6.3227
# DEMO_MAP_LNG=107.3376
# DEMO_MAP_LABEL=Karawang, Jawa Barat (Lokasi Demo)

# --- Open-Meteo Air Quality (tanpa API key untuk non-komersial) ---
# AIR_CACHE_MINUTES=30
# AIR_TIMEOUT_MS=8000

# --- Berita RSS ---
# NEWS_AUTO_FETCH=true
# NEWS_FETCH_INTERVAL_HOURS=6

# --- Reset kata sandi ---
# Layanan email/SMS belum terhubung. true = tautan reset ditampilkan di layar (hanya untuk demo).
# DEMO_SHOW_RESET_LINK=true
